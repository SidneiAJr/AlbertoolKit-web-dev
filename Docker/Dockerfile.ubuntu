FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    curl \
    wget \
    git \
    vim \
    htop \
    net-tools \
    iputils-ping \
    python3 \
    python3-pip \
    nodejs \
    npm \
    mysql-client \
    redis-tools \
    && apt-get clean

WORKDIR /workspace

CMD ["tail", "-f", "/dev/null"]
