{
    "name": "seuprojeto/react-native-enterprise",
    "description": "Projeto React Native enterprise com monitoramento, segurança e CI/CD ready",
    "version": "0.0.1",
    "private": true,
    "main": "expo-router/entry",
    "scripts": {
        "start": "expo start",
        "android": "expo start --android",
        "ios": "expo start --ios",
        "web": "expo start --web",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "format": "prettier --write src",
        "format:check": "prettier --check src",
        "test": "jest",
        "test:coverage": "jest --coverage",
        "test:e2e": "detox test",
        "prepare": "husky install"
    },
    "dependencies": {
        "expo": "~52.0.0",
        "expo-status-bar": "~2.0.0",
        "expo-router": "~4.0.0",
        "expo-async-storage": "^2.1.0",
        "expo-notifications": "~0.29.0",
        "expo-image-picker": "~15.0.0",
        "expo-camera": "~15.0.0",
        "expo-location": "~17.0.0",
        "expo-maps": "~0.1.0",
        "expo-local-authentication": "~14.0.0",
        "expo-secure-store": "~13.0.0",
        "expo-document-picker": "~12.0.0",
        "expo-file-system": "~17.0.0",
        "expo-sharing": "~12.0.0",
        "expo-av": "~14.0.0",
        "expo-crypto": "~13.0.0",
        "react": "18.3.1",
        "react-native": "0.76.0",
        "react-native-safe-area-context": "^4.10.0",
        "react-native-screens": "^3.31.0",
        "react-native-paper": "^5.12.0",
        "react-native-vector-icons": "^10.1.0",
        "react-native-reanimated": "~3.16.0",
        "react-native-gesture-handler": "~2.20.0",
        "react-native-gifted-charts": "^1.4.0",
        "react-native-gifted-chat": "^2.4.0",
        "react-native-mmkv": "^2.12.0",
        "react-native-keychain": "^8.2.0",
        "axios": "^1.6.0",
        "zustand": "^4.5.0",
        "react-hook-form": "^7.50.0",
        "zod": "^3.22.0",
        "@hookform/resolvers": "^3.3.0",
        "@tanstack/react-query": "^5.20.0",
        "date-fns": "^3.3.0",
        "socket.io-client": "^4.7.0",
        "i18next": "^23.10.0",
        "react-i18next": "^14.1.0",
        "react-native-stripe-sdk": "^0.35.0",
        "@sentry/react-native": "^5.22.0"
    },
    "devDependencies": {
        "@babel/core": "^7.24.0",
        "@types/react": "~18.3.0",
        "@types/react-native-vector-icons": "^6.4.0",
        "typescript": "^5.3.0",
        "eslint": "^9.0.0",
        "prettier": "^3.2.0",
        "jest": "^29.7.0",
        "@testing-library/react-native": "^12.4.0",
        "jest-expo": "~52.0.0",
        "detox": "^20.18.0",
        "husky": "^9.0.0",
        "lint-staged": "^15.2.0"
    },
    "jest": {
        "preset": "jest-expo"
    },
    "lint-staged": {
        "src/**/*.{ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ]
    }
}
