{
  "family": "meu-projeto",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::SUA_CONTA_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::SUA_CONTA_ID:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "meu-projeto",
      "image": "SUA_CONTA_ID.dkr.ecr.us-east-1.amazonaws.com/meu-projeto:latest",
      "memory": 512,
      "memoryReservation": 256,
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "3000"
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:SUA_CONTA_ID:secret:meu-projeto/database-url"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:SUA_CONTA_ID:secret:meu-projeto/jwt-secret"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/meu-projeto",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:3000/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "essential": true
    }
  ]
}
