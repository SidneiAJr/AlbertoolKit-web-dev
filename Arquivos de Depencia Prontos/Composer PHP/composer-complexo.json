{
    "name": "seuprojeto/php-complexo",
    "description": "Projeto PHP completo com cache e validação",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "vlucas/phpdotenv": "^5.5",
        "monolog/monolog": "^3.5",
        "doctrine/orm": "^2.16",
        "doctrine/dbal": "^3.7",
        "firebase/php-jwt": "^6.10",
        "symfony/cache": "^6.3",
        "symfony/validator": "^6.3",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "mockery/mockery": "^1.6",
        "squizlabs/php_codesniffer": "^3.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    }
}
