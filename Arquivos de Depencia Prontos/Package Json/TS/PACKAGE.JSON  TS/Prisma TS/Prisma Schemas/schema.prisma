// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ===== ADICIONE SEUS MODELS ABAIXO =====

model User {
  id Int @id @default(autoincrement())

  @@map("users")
}

