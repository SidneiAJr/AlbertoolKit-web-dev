{
  "name": "electron-app-avancado",
  "version": "1.0.0",
  "description": "App Electron avançado",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --inspect",
    "build": "electron-builder",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win --mac --linux"
  },
  "dependencies": {
    "electron": "^31.0.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7",
    "better-sqlite3": "^9.4.3",
    "chokidar": "^3.5.3",
    "node-pty": "^1.0.0",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "electron-builder": "^24.9.1",
    "electron-reload": "^2.0.0-alpha.1",
    "eslint": "^8.51.0"
  },
  "build": {
    "appId": "com.seuapp.id",
    "productName": "MeuApp",
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
